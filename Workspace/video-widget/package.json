{
  "name": "bank-video-widget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "远程视频银行 · 独立视频控件（契约 §2.9）：零 TS 零 Vue 的原生 JS 内核 + 视图层，vite lib 构建 ESM/UMD/CSS 三件产物；由 agent-web / channel-web-sdk 以打包或 script 方式加载",
  "main": "dist/vb-video.umd.js",
  "module": "dist/vb-video.esm.js",
  "exports": {
    ".": {
      "import": "./dist/vb-video.esm.js",
      "require": "./dist/vb-video.umd.js"
    },
    "./style.css": "./dist/vb-video.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:only": "node --test \"tests/**/*.test.mjs\"",
    "ci": "npm run build && npm run test:only"
  },
  "keywords": [
    "video",
    "webrtc",
    "peerjs",
    "mediarecorder",
    "remote-video-banking"
  ],
  "devDependencies": {
    "vite": "^8.3.4"
  },
  "license": "UNLICENSED"
}
