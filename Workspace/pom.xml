<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
    </parent>

    <groupId>com.example.bank</groupId>
    <artifactId>bank-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>bank-platform</name>

    <properties>
        <java.version>1.8</java.version>
        <flowable.version>6.8.0</flowable.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
      各服务独立进程、独立端口，服务间只经 HTTP 通信，因此模块之间没有 jar 依赖。
      一旦让某个服务依赖另一个服务的 jar，Spring 会把对方的 Bean 一并加载进同一进程，
      进程边界就失效了 —— 这是本拆分要守住的底线。
    -->
    <modules>
        <module>signaling-svc</module>
        <module>media-svc</module>
        <module>workflow-svc</module>
        <module>routing-svc</module>
        <module>business-svc</module>
        <module>message-svc</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>1.8</source>
                        <target>1.8</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
