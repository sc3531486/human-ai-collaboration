<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="Bank">
<process id="password_reset_sop" name="密码重置" isExecutable="true"><extensionElements><flowable:notify targets="CUSTOMER"/></extensionElements><startEvent id="start"/>
<receiveTask id="card_capture" name="客户拍摄银行卡"><extensionElements>
<flowable:handling handler="DIGITAL" submitter="CUSTOMER" assignment="NONE" retainAgent="false" communication="NONE" mobilePage="password-card-camera" agentPage="password-wait"/>
<flowable:notify targets="CUSTOMER"/>
<flowable:field name="actors" stringValue="CUSTOMER"/><flowable:field name="actionCode" stringValue="SUBMIT"/>
<flowable:field name="ui"><flowable:string><![CDATA[{"view":"password-card-camera","title":"拍摄银行卡","fields":[{"name":"selected_card_id","label":"办理银行卡","type":"card","required":true},{"name":"media_photo","label":"银行卡照片","type":"photo","evidenceKind":"MEDIA","required":true}]}]]></flowable:string></flowable:field>
<flowable:capability code="password.cards.v1" inputs="customerId=customer_id" outputs="cards=cards" phase="start" readOnly="true"/><flowable:executionListener event="start" delegateExpression="${businessNodeActions}"/>
</extensionElements></receiveTask>
<receiveTask id="id_front_capture" name="客户拍摄身份证正面"><extensionElements>
<flowable:handling handler="DIGITAL" submitter="CUSTOMER" assignment="NONE" retainAgent="false" communication="NONE" mobilePage="password-id-front-camera" agentPage="password-wait"/>
<flowable:notify targets="CUSTOMER"/>
<flowable:field name="actors" stringValue="CUSTOMER"/><flowable:field name="actionCode" stringValue="SUBMIT"/>
<flowable:field name="ui"><flowable:string><![CDATA[{"view":"password-id-front-camera","title":"拍摄身份证正面","fields":[{"name":"id_front_photo","label":"身份证人像面","type":"photo","evidenceKind":"ID_FRONT","required":true}]}]]></flowable:string></flowable:field>
</extensionElements></receiveTask>
<receiveTask id="id_back_capture" name="客户拍摄身份证反面"><extensionElements>
<flowable:handling handler="DIGITAL" submitter="CUSTOMER" assignment="NONE" retainAgent="false" communication="NONE" mobilePage="password-id-back-camera" agentPage="password-wait"/>
<flowable:notify targets="CUSTOMER"/>
<flowable:field name="actors" stringValue="CUSTOMER"/><flowable:field name="actionCode" stringValue="SUBMIT"/>
<flowable:field name="ui"><flowable:string><![CDATA[{"view":"password-id-back-camera","title":"拍摄身份证反面","fields":[{"name":"id_back_photo","label":"身份证国徽面","type":"photo","evidenceKind":"ID_BACK","required":true}]}]]></flowable:string></flowable:field>
</extensionElements></receiveTask>
<receiveTask id="customer_face_capture" name="客户采集人脸"><extensionElements>
<flowable:handling handler="DIGITAL" submitter="CUSTOMER" assignment="NONE" retainAgent="false" communication="NONE" mobilePage="password-face-camera" agentPage="password-wait"/>
<flowable:notify targets="CUSTOMER"/>
<flowable:field name="actors" stringValue="CUSTOMER"/><flowable:field name="actionCode" stringValue="SUBMIT"/>
<flowable:field name="ui"><flowable:string><![CDATA[{"view":"password-face-camera","title":"人脸采集","fields":[{"name":"face_photo","label":"现场人脸照片","type":"photo","evidenceKind":"FACE","required":true}]}]]></flowable:string></flowable:field>
</extensionElements></receiveTask>
<serviceTask id="password_identity" name="联网核查与人脸比对" flowable:delegateExpression="${apiTaskDelegate}"><extensionElements>
<flowable:capability code="password.customer-identity.v1" inputs="customerId=customer_id,cardId=selected_card_id,mediaPhoto=media_photo,idFrontPhoto=id_front_photo,idBackPhoto=id_back_photo,customerFacePhoto=face_photo" outputs="identityPassed=identityPassed,identityAuditId=identityAuditId,faceScore=faceScore,faceThreshold=faceThreshold,onlinePassed=onlinePassed,idFrontOcr=idFrontOcr,idBackOcr=idBackOcr,onlineResult=onlineResult,identityMessage=identityMessage,policyUpdatedAt=policyUpdatedAt" phase="execute" readOnly="true"/>
</extensionElements></serviceTask>
<exclusiveGateway id="identity_gateway" default="identity_escalate"/>
<userTask id="verification_review" name="坐席核验结果处理"><extensionElements>
<flowable:handling handler="HUMAN" submitter="AGENT" assignment="NEW" skillGroup="GENERAL" retainAgent="true" communication="VIDEO" mobilePage="witness" agentPage="password-review"/>
<flowable:transition releaseAgent="false" closeRoom="false"/>
<flowable:notify targets="CUSTOMER,AGENT"/>
<flowable:field name="actors" stringValue="AGENT"/><flowable:field name="actionCode" stringValue="PROCEED,REQUEST_AUTH"/>
<flowable:field name="ui"><flowable:string><![CDATA[{"view":"password-review","title":"身份核验结果","fields":[{"name":"review_reason","label":"授权原因","type":"text"}]}]]></flowable:string></flowable:field>
<flowable:capability code="password.review.v1" inputs="identityAuditId=identityAuditId,action=action" outputs="needsAuthorization=needsAuthorization" phase="end" readOnly="true"/><flowable:executionListener event="start" delegateExpression="${businessNodeActions}"/><flowable:executionListener event="end" delegateExpression="${businessNodeActions}"/>
<flowable:taskListener event="create" delegateExpression="${businessNodeActions}"/>
</extensionElements></userTask>
<exclusiveGateway id="verification_gateway" default="verified"/>
<serviceTask id="authorization_request" name="创建统一授权申请" flowable:delegateExpression="${apiTaskDelegate}"><extensionElements><flowable:capability code="authorization.create.v1" inputs="reason=review_reason" outputs="authorization_id=authorizationId" phase="execute" readOnly="false"/></extensionElements></serviceTask>
<callActivity id="unified_authorization" name="统一授权" calledElement="unified_authorization_sop"><extensionElements>
<flowable:in sourceExpression="${execution.processInstanceId}" target="parent_process_id"/>
<flowable:in sourceExpression="${flowData.value(execution,'authorization_id')}" target="authorization_id"/>
<flowable:in source="biz_no" target="biz_no"/><flowable:in source="customer_id" target="customer_id"/>
<flowable:in source="customer_name" target="customer_name"/><flowable:in source="mobile_peer_id" target="mobile_peer_id"/>
<flowable:in source="customer_level" target="customer_level"/><flowable:in source="customer_level_name" target="customer_level_name"/><flowable:in source="channel" target="channel"/>
<flowable:in source="agent_session_id" target="authorization_requester"/>
<flowable:in sourceExpression="${'AUTHORIZER'}" target="participant_role"/><flowable:in sourceExpression="${'AUTHORIZATION'}" target="customer_skill_group"/><flowable:in sourceExpression="${'AUTHORIZATION'}" target="biz_type"/>
<flowable:out sourceExpression="${flowData.value(execution,'authorizationApproved')}" target="authorizationApproved"/>
<flowable:out sourceExpression="${flowData.value(execution,'authorizationDecisionId')}" target="authorizationDecisionId"/>
<flowable:out sourceExpression="${flowData.value(execution,'authorizationMessage')}" target="resetMessage"/>
</extensionElements></callActivity>
<exclusiveGateway id="authorization_gateway" default="authorization_denied"/>
<receiveTask id="sms_verify" name="客户短信验证"><extensionElements>
<flowable:handling handler="DIGITAL" submitter="CUSTOMER" assignment="NONE" retainAgent="true" communication="KEEP" mobilePage="password-sms" agentPage="password-wait"/>
<flowable:notify targets="CUSTOMER,AGENT"/>
<flowable:field name="actors" stringValue="CUSTOMER"/><flowable:field name="actionCode" stringValue="SUBMIT"/>
<flowable:field name="ui"><flowable:string><![CDATA[{"view":"password-sms","title":"短信验证","actionLabel":"验证短信验证码","displayFields":[{"name":"smsDeliveryMessage","label":"短信发送情况"},{"name":"smsVerifyMessage","label":"验证码校验"}],"fields":[{"name":"sms_code","label":"短信验证码","type":"text","pattern":"[0-9]{6}","maxLength":6,"required":true}]}]]></flowable:string></flowable:field>
<flowable:capability code="sms.send.v1" inputs="customerId=customer_id,cardId=selected_card_id" outputs="smsChallengeId=smsChallengeId,smsDeliveryMessage=smsDeliveryMessage" phase="start" readOnly="false"/><flowable:capability code="sms.verify.v1" inputs="customerId=customer_id,cardId=selected_card_id,challengeId=smsChallengeId,code=sms_code" outputs="smsPassed=smsPassed,smsVerificationId=smsVerificationId,smsVerifyMessage=smsVerifyMessage" phase="end" readOnly="false"/><flowable:executionListener event="start" delegateExpression="${businessNodeActions}"/><flowable:executionListener event="end" delegateExpression="${businessNodeActions}"/>

</extensionElements></receiveTask>
<exclusiveGateway id="sms_gateway" default="sms_retry"/>
<receiveTask id="customer_sign" name="客户签署业务办理单"><extensionElements>
<flowable:handling handler="DIGITAL" submitter="CUSTOMER" assignment="NONE" retainAgent="true" communication="KEEP" mobilePage="password-sign" agentPage="password-wait"/>
<flowable:notify targets="CUSTOMER,AGENT"/>
<flowable:field name="actors" stringValue="CUSTOMER"/><flowable:field name="actionCode" stringValue="SUBMIT"/>
<flowable:field name="ui"><flowable:string><![CDATA[{"view":"password-sign","title":"核对办理单并签字","actionLabel":"提交签字","signatureScope":["serviceFormId","selected_card_id","customer_id","identityAuditId","smsVerificationId"],"displayFields":[{"name":"serviceFormUrl","label":"业务办理单","type":"document"}],"fields":[{"name":"signature_image","label":"客户签字","type":"signature","evidenceKind":"CUSTOMER_SIGNATURE","required":true},{"name":"service_form_confirmed","label":"已核对办理单并同意密码重置","type":"checkbox","required":true}]}]]></flowable:string></flowable:field>
<flowable:capability code="password.form.v1" inputs="customerId=customer_id,cardId=selected_card_id,identityAuditId=identityAuditId,smsVerificationId=smsVerificationId,customerName=customer_name" outputs="serviceFormId=serviceFormId,serviceFormUrl=serviceFormUrl" phase="start" readOnly="false"/><flowable:executionListener event="start" delegateExpression="${businessNodeActions}"/><flowable:executionListener event="end" delegateExpression="${businessNodeActions}"/>

</extensionElements></receiveTask>
<userTask id="signature_review" name="坐席核实办理单签名"><extensionElements>
<flowable:handling handler="HUMAN" submitter="AGENT" assignment="REUSE" skillGroup="GENERAL" retainAgent="true" communication="VIDEO" mobilePage="witness" agentPage="password-signature-review"/>
<flowable:transition releaseAgent="false" closeRoom="false"/>
<flowable:notify targets="CUSTOMER,AGENT"/>
<flowable:field name="actors" stringValue="AGENT"/><flowable:field name="actionCode" stringValue="AUTHORIZE,REJECT"/>
<flowable:field name="ui"><flowable:string><![CDATA[{"view":"password-signature-review","title":"办理单与签名核实","actionLabel":"确认提交密码重置","fields":[{"name":"signature_review_confirmed","label":"签字与本次办理单核实无误","type":"checkbox","required":true},{"name":"review_reason","label":"退回原因","type":"text"}]}]]></flowable:string></flowable:field>
<flowable:capability code="password.signature.v1" inputs="serviceFormId=serviceFormId,signatureImage=signature_image,agentId=agent_session_id,confirmed=signature_review_confirmed" outputs="signatureDocumentId=signatureDocumentId,signatureDocumentUrl=signatureDocumentUrl" phase="end" readOnly="false"/><flowable:executionListener event="start" delegateExpression="${businessNodeActions}"/><flowable:executionListener event="end" delegateExpression="${businessNodeActions}"/>
<flowable:taskListener event="create" delegateExpression="${businessNodeActions}"/>
</extensionElements></userTask>
<exclusiveGateway id="signature_gateway" default="signature_approved"/>
<serviceTask id="reset_password" name="执行密码重置" flowable:delegateExpression="${apiTaskDelegate}"><extensionElements><flowable:capability code="password.reset.v1" inputs="customerId=customer_id,cardId=selected_card_id,identityAuditId=identityAuditId,authorizationId=authorizationDecisionId,smsVerificationId=smsVerificationId,signatureDocumentId=signatureDocumentId" outputs="resetReceipt=resetReceipt,resetStatus=resetStatus,resetMessage=resetMessage,resetCardMasked=resetCardMasked,business_success=_succeeded" phase="execute" readOnly="false"/><flowable:capability code="password.receipt.v1" inputs="customerId=customer_id,cardId=selected_card_id,identityAuditId=identityAuditId,smsVerificationId=smsVerificationId,signatureDocumentId=signatureDocumentId,resetReceipt=resetReceipt,resetStatus=resetStatus" outputs="receiptPdfUrl=receiptPdfUrl" phase="execute" readOnly="false"/></extensionElements></serviceTask>
<endEvent id="end"/><endEvent id="denied" name="授权未通过"/>
<sequenceFlow id="start_card" sourceRef="start" targetRef="card_capture"/>
<sequenceFlow id="card_front" sourceRef="card_capture" targetRef="id_front_capture"/>
<sequenceFlow id="front_back" sourceRef="id_front_capture" targetRef="id_back_capture"/>
<sequenceFlow id="back_face" sourceRef="id_back_capture" targetRef="customer_face_capture"/>
<sequenceFlow id="face_identity" sourceRef="customer_face_capture" targetRef="password_identity"/>
<sequenceFlow id="identity_result" sourceRef="password_identity" targetRef="identity_gateway"/>
<sequenceFlow id="identity_passed" sourceRef="identity_gateway" targetRef="sms_verify"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${flowData.value(execution,'identityPassed') == true}]]></conditionExpression></sequenceFlow>
<sequenceFlow id="identity_escalate" sourceRef="identity_gateway" targetRef="verification_review"/>
<sequenceFlow id="e" sourceRef="verification_review" targetRef="verification_gateway"></sequenceFlow>
<sequenceFlow id="request_auth" sourceRef="verification_gateway" targetRef="authorization_request"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${flowData.value(execution,'needsAuthorization') == true}]]></conditionExpression></sequenceFlow>
<sequenceFlow id="verified" sourceRef="verification_gateway" targetRef="sms_verify"></sequenceFlow>
<sequenceFlow id="f" sourceRef="authorization_request" targetRef="unified_authorization"></sequenceFlow>
<sequenceFlow id="g" sourceRef="unified_authorization" targetRef="authorization_gateway"></sequenceFlow>
<sequenceFlow id="authorization_approved" sourceRef="authorization_gateway" targetRef="sms_verify"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${flowData.value(execution,'authorizationApproved') == true}]]></conditionExpression></sequenceFlow>
<sequenceFlow id="authorization_denied" sourceRef="authorization_gateway" targetRef="denied"></sequenceFlow>
<sequenceFlow id="h" sourceRef="sms_verify" targetRef="sms_gateway"></sequenceFlow>
<sequenceFlow id="sms_passed" sourceRef="sms_gateway" targetRef="customer_sign"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${flowData.value(execution,'smsPassed') == true}]]></conditionExpression></sequenceFlow>
<sequenceFlow id="sms_retry" sourceRef="sms_gateway" targetRef="sms_verify"></sequenceFlow>
<sequenceFlow id="i" sourceRef="customer_sign" targetRef="signature_review"></sequenceFlow>
<sequenceFlow id="j" sourceRef="signature_review" targetRef="signature_gateway"></sequenceFlow>
<sequenceFlow id="signature_rejected" sourceRef="signature_gateway" targetRef="customer_sign"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${action == 'REJECT'}]]></conditionExpression></sequenceFlow>
<sequenceFlow id="signature_approved" sourceRef="signature_gateway" targetRef="reset_password"></sequenceFlow>
<sequenceFlow id="k" sourceRef="reset_password" targetRef="end"></sequenceFlow>
</process></definitions>
