        <omgdi:waypoint x="408.0" y="153.66667"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AUTO_EDGE_advanced_sop_c" bpmnElement="c">
        <omgdi:waypoint x="528.0" y="153.66667"/>
        <omgdi:waypoint x="628.0" y="153.66667"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AUTO_EDGE_advanced_sop_risk_manual" bpmnElement="risk_manual">
