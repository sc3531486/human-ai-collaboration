      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AUTO_SHAPE_advanced_sop_ai_collect" bpmnElement="ai_collect">
        <omgdc:Bounds x="193.0" y="116.166695" width="105.0" height="74.99999"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AUTO_SHAPE_advanced_sop_customer_sign" bpmnElement="customer_sign">
        <omgdc:Bounds x="998.0" y="108.666664" width="120.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AUTO_SHAPE_advanced_sop_request_gateway" bpmnElement="request_gateway">
