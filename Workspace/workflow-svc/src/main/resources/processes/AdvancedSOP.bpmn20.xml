      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AUTO_SHAPE_advanced_sop_risk_gateway" bpmnElement="risk_gateway">
        <omgdc:Bounds x="628.0" y="128.66667" width="50.0" height="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AUTO_SHAPE_advanced_sop_review_gateway" bpmnElement="review_gateway">
        <omgdc:Bounds x="1438.0" y="128.66667" width="50.0" height="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="AUTO_EDGE_advanced_sop_a" bpmnElement="a">
        <omgdi:waypoint x="88.0" y="153.66667"/>
        <omgdi:waypoint x="193.0" y="153.6667"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AUTO_EDGE_advanced_sop_collect_request" bpmnElement="collect_request">
        <omgdi:waypoint x="298.0" y="153.66667"/>
        <omgdi:waypoint x="328.0" y="153.66667"/>
      </bpmndi:BPMNEdge>
